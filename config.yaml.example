# ══════════════════════════════════════════════════════════════════════════════
# config.yaml.example — Template MyDigitalTwin
# ══════════════════════════════════════════════════════════════════════════════
# Copier ce fichier : cp config.yaml.example config.yaml
# Puis remplacer les valeurs par vos propres données.

user:
  instagram_sender_name: "VOTRE NOM"   # Tel qu'il apparaît dans les exports Instagram
  instagram_username: "votre_username" # Optionnel, utile pour certains traitements futurs

social:
  close_friends_multiplier: 2.0
  min_messages: 5
  close_friends:
    - "pseudo_ami_1"
    - "pseudo_ami_2"
    # Ajouter les pseudos Instagram de vos proches

spotify:
  anchor_artists:
    - "Artiste 1"
    - "Artiste 2"
  topology_stream_threshold: 5   # écoutes minimum pour apparaître dans le graphe

clone:
  conversations:
    ami1: ["ami1_conversation_id"]
    ami2: ["ami2_conversation_id"]
    # IDs trouvés dans data/processed/INSTAGRAM/.../messages/inbox/

clustering:
  # Nombre de clusters K-Means sur les profils temporels de plateformes.
  # Plus K est grand = profils plus fins mais moins stables.
  # Recommandé : entre 3 et 8 selon le nombre de plateformes utilisées.
  k_behavioral: 4

# Mots-clés par catégorie pour classifier les contenus (Spotify, YouTube, Netflix…).
# Renommer les catégories et adapter les mots-clés à vos propres centres d'intérêt.
category_keywords:
  Sport:
    - football
    - tennis
    - basketball
    # Ajouter vos sports / équipes / compétitions
  Tech:
    - python
    - data
    - ai
    # Ajouter vos sujets tech
  Musique:
    - rap
    - album
    - concert
    # Ajouter vos artistes, genres, labels
  # Ajouter ou supprimer des catégories librement
