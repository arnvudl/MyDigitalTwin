# ── Memory Album ──────────────────────────────────────────────────────────────
memory_album:
  # Modèle vision pour captions + embeddings
  # "Salesforce/blip2-opt-2.7b" ≈ 5 Go VRAM (recommandé GPU)
  # Fallback auto sur OpenCLIP si CUDA indisponible
  model: "Salesforce/blip2-opt-2.7b"

  # Taille de lot images par appel modèle
  # 8 = bon équilibre pour 8 Go VRAM ; réduire à 4 si OOM
  batch_size: 8

  # Partitions Spark = nombre de chargements du modèle
  # Garder à 1 avec GPU (BLIP-2 ~5 Go) ; monter à 4 en CPU only
  n_partitions: 1

  # Groupement temporel (remplace HDBSCAN)
  # Écart > scene_gap_hours entre deux photos consécutives = nouveau groupe
  scene_gap_hours: 6.0

  # Fenêtre de matching temporel photo ↔ Spotify (en minutes)
  temporal_window_minutes: 60

  # ID de la playlist Spotify source pour la bibliothèque musicale
  # Obtenu via : https://open.spotify.com/playlist/<ID>
  spotify_playlist_id: "YOUR_PLAYLIST_ID_HERE"

  # Overrides manuels : imposer une musique à une ou plusieurs photos
  # photo_id = hash MD5 du chemin affiché par le notebook 01
  manual_overrides: []
  # Exemple :
  # - photo_id: "a1b2c3d4"
  #   track_id:  "spotify:track:4x6jx7AeSyE7PlQTdCjIJs"

# ── CLIP Photo Clustering ──────────────────────────────────────────────────────
clip:
  # Labels zero-shot pour la classification CLIP des photos
  # Adapter selon ton corpus de photos (lieux, ambiances, activités…)
  candidate_labels:
    - "soiree entre amis"
    - "concert ou festival"
    - "voyage et paysage"
    - "nourriture et restaurant"
    - "sport et fitness"
    - "famille"
    - "ville et architecture"
    - "nature et randonnee"
    - "selfie portrait"
    - "plage et vacances"
    - "meme et humour internet"
    - "photo du quotidien entre amis"
    - "photo de voiture"

# ── Page Psy (Miroir) ──────────────────────────────────────────────────────────
psy:
  # Prénoms à anonymiser dans les exports de messages
  first_names:
    - "Alice"
    - "Emma"
    - "Hugo"
    - "Léa"
    - "Lucas"
    - "Chloé"
    - "Inès"
    - "Jade"
    - "Noah"
    - "Léo"

  # Marqueurs de raisonnement (style d'écriture)
  reasoning_markers:
    - "parce que"
    - "du coup"
    - "je pense"
    - "en vrai"
    - "en fait"
    - "donc"
    - "c'est que"
    - "ça veut dire"
    - "au final"
    - "genre"

  # Tics verbaux (langage familier)
  verbal_tics:
    - "jsp"
    - "bah"
    - "mdr"
    - "lol"
    - "wtf"
    - "pk"
    - "ouais"
    - "nan"

  # Catégories comportementales et leurs mots-clés associés
  behaviour_categories:
    "Santé / Corps":
      - "maladie"
      - "symptôme"
      - "douleur"
      - "médecin"
      - "fatigue"
      - "anxiété"
      - "stress"
      - "dépression"
      - "sommeil"
      - "santé"
    "Tech / IA":
      - "python"
      - "ia"
      - "llm"
      - "gpt"
      - "machine learning"
      - "code"
      - "github"
      - "docker"
      - "data"
      - "algorithme"
    "Questions existentielles":
      - "sens de la vie"
      - "bonheur"
      - "solitude"
      - "mort"
      - "avenir"
      - "identité"
      - "liberté"
      - "relation"
      - "amour"
      - "but"
    "Finance / Carrière":
      - "salaire"
      - "emploi"
      - "stage"
      - "argent"
      - "budget"
      - "investissement"
      - "bourse"
      - "crypto"
      - "entreprise"
      - "startup"
    "Divertissement":
      - "film"
      - "série"
      - "musique"
      - "concert"
      - "jeu"
      - "sport"
      - "netflix"
      - "spotify"
      - "youtube"
      - "anime"

# ── Clone conversationnel ─────────────────────────────────────────────────────
clone:
  conversations:
    ami1: ["ami1_CONVERSATION_ID"]
    ami2: ["ami2_CONVERSATION_ID"]
    ami3: ["ami3_CONVERSATION_ID"]
