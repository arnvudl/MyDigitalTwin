# ══════════════════════════════════════════════════════════════════════════════
# config.yaml.example — Modèle à copier
# ══════════════════════════════════════════════════════════════════════════════
# 1. Copier ce fichier : cp config.yaml.example config.yaml
# 2. Remplacer toutes les valeurs d'exemple par vos propres données.
# 3. Ne jamais commiter config.yaml (il est dans .gitignore).

# ── Identité ──────────────────────────────────────────────────────────────────
user:
  # Votre nom tel qu'il apparaît dans les messages Instagram exportés
  instagram_sender_name: "Prénom Nom"
  # Votre username Instagram
  instagram_username: "votre_pseudo_instagram"

# ── Graphe social Instagram ───────────────────────────────────────────────────
social:
  close_friends_multiplier: 2.0   # poids des messages avec les proches
  min_messages: 5                  # seuil minimum pour apparaître dans le graphe
  close_friends:
    - "ami1"
    - "ami2"
    - "ami3"

# ── Spotify ───────────────────────────────────────────────────────────────────
spotify:
  # Artistes de référence pour contextualiser le profil musical
  anchor_artists:
    - "Artiste 1"
    - "Artiste 2"
    - "Artiste 3"
  # Seuil d'écoutes répétées pour inclure un titre dans le graphe topologique
  # Un titre écouté >= N fois = signal d'intérêt fort
  topology_stream_threshold: 20

# ── Clustering comportemental ─────────────────────────────────────────────────
clustering:
  # Nombre de clusters K-Means sur les profils temporels de plateformes.
  # Plus K est grand = profils plus fins mais moins stables.
  # Recommandé : entre 3 et 8 selon le nombre de plateformes utilisées.
  k_behavioral: 4

# ── Catégories d'intérêts (content clustering) ────────────────────────────────
# Mots-clés par catégorie pour classifier les contenus (Spotify, YouTube, Netflix…).
# Ajouter / supprimer / renommer les catégories selon tes centres d'intérêt.
