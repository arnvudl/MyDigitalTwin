# ── CLONE CONVERSATIONNEL ─────────────────────────────────────────────────────
# Clé API Gemini — https://aistudio.google.com/app/apikey (gratuit)
GEMINI_API_KEY=votre_cle_gemini_ici

# ── DASHBOARD & MEMORY ALBUM ──────────────────────────────────────────────────
# Créer une app sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=votre_client_id_ici
SPOTIFY_CLIENT_SECRET=votre_client_secret_ici

# ── FILMS (optionnel) ─────────────────────────────────────────────────────────
# Clé TMDB pour les affiches films — https://www.themoviedb.org/settings/api
TMDB_API_KEY=votre_cle_api_ici
TMDB_ACCESS_TOKEN=votre_jeton_acces_ici

# ── DASHBOARD ─────────────────────────────────────────────────────────────────
# Port et host du serveur Dash (optionnel — défauts : 0.0.0.0:8050)
# DASH_HOST=0.0.0.0
# DASH_PORT=8050
