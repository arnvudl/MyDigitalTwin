# ── Memory Album ──────────────────────────────────────────────────────────────
memory_album:
  model: "Salesforce/blip2-opt-2.7b"
  batch_size: 8
  n_partitions: 1
  scene_gap_hours: 6.0
  temporal_window_minutes: 60
  spotify_playlist_id: "YOUR_PLAYLIST_ID_HERE"
  manual_overrides: []

# ── CLIP Photo Clustering ──────────────────────────────────────────────────────
clip:
  candidate_labels:
    - "soiree entre amis"
    - "concert ou festival"
    - "voyage et paysage"
    - "nourriture et restaurant"
    - "sport et fitness"
    - "famille"
    - "ville et architecture"
    - "nature et randonnee"
    - "selfie portrait"
    - "plage et vacances"
    - "meme et humour internet"
    - "photo du quotidien entre amis"

