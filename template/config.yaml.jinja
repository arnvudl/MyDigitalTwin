# ══════════════════════════════════════════════════════════════════════════════
# config.yaml — Données personnelles MyDigitalTwin
# ══════════════════════════════════════════════════════════════════════════════
# Ce fichier est propre à CHAQUE utilisateur. Ne pas commiter (voir .gitignore).
# Généré par : copier copy gh:ton-user/MyDigitalTwin .

# ── Identité ──────────────────────────────────────────────────────────────────
user:
  # Nom dans les messages Instagram exportés
  instagram_sender_name: "{{ instagram_sender_name }}"
  # Votre username Instagram
  instagram_username: "{{ instagram_username }}"

# ── Graphe social Instagram ───────────────────────────────────────────────────
social:
  close_friends_multiplier: 2.0
  min_messages: 5
  close_friends:
    - "ami1"   # ← Remplacer par vos usernames Instagram proches

# ── Spotify ───────────────────────────────────────────────────────────────────
spotify:
  anchor_artists:
    - "Artiste 1"   # ← Remplacer par vos artistes de référence
    - "Artiste 2"
  topology_stream_threshold: 20

# ── Clustering comportemental ─────────────────────────────────────────────────
clustering:
  k_behavioral: 4

