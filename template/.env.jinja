# ── DASHBOARD & MEMORY ALBUM ──────────────────────────────────────────────────
# Créer une app sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID={{ spotify_client_id if spotify_client_id else "votre_client_id_ici" }}
SPOTIFY_CLIENT_SECRET={{ spotify_client_secret if spotify_client_secret else "votre_client_secret_ici" }}

# ── FILMS (optionnel) ─────────────────────────────────────────────────────────
# Clé TMDB pour les affiches films — https://www.themoviedb.org/settings/api
TMDB_API_KEY={{ tmdb_api_key if tmdb_api_key else "votre_cle_api_ici" }}
TMDB_ACCESS_TOKEN={{ tmdb_access_token if tmdb_access_token else "votre_jeton_acces_ici" }}

# ── DASHBOARD ─────────────────────────────────────────────────────────────────
# Port et host du serveur Dash (optionnel — défauts : 0.0.0.0:8050)
# DASH_HOST=0.0.0.0
# DASH_PORT=8050
